<odoo>

    <record id="view_partner_form_whatsapp_button" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!--
                Next to the number rather than in the button box: the button is
                about this number, and putting it beside the field is what makes
                its absence legible when the number is unusable.
            -->
            <field name="mobile" position="after">
                <field name="whatsapp_link" invisible="1"/>
                <button name="action_open_whatsapp" type="object"
                        string="WhatsApp" icon="fa-comments"
                        class="btn-link ps-0"
                        invisible="not whatsapp_link"
                        title="Open a WhatsApp chat with this number"/>
            </field>
        </field>
    </record>

</odoo>
